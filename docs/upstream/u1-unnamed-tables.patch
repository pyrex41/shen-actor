@@ -91,3 +97,71 @@ t_numeric_equality(_Config) ->
   true = H >= 1,
   true = shen_erl_kl_overrides:'integer?'(4.0),
   false = shen_erl_kl_overrides:'integer?'(4.5).
+
+%% Absvectors, tuples and dictionaries are backed by unnamed ETS tables:
+%% allocating them must not create atoms (named tables used to leak one
+%% DICT<n> atom per allocation and exhaust the atom table).
+t_vector_alloc_no_atoms(_Config) ->
+  %% Warm up so module loading does not count against the measurement.
+  _ = shen_erl_kl_primitives:absvector(4),
+  _ = shen_erl_kl_overrides:'@p'(a, b),
+  _ = shen_erl_kl_overrides:'shen.dict'(8),
+  Atoms0 = erlang:system_info(atom_count),
+  Tabs0 = length(ets:all()),
+  Vecs = [shen_erl_kl_primitives:absvector(4) || _ <- lists:seq(1, 1000)],
+  Tuples = [shen_erl_kl_overrides:'@p'(I, I) || I <- lists:seq(1, 1000)],
+  Dicts = [shen_erl_kl_overrides:'shen.dict'(8) || _ <- lists:seq(1, 1000)],
+  0 = erlang:system_info(atom_count) - Atoms0,
+  3000 = length(ets:all()) - Tabs0,
+  [true = is_reference(Tab) || {vector, 4, Tab} <- Vecs],
+  [true = is_reference(Tab) || {dict, Tab} <- Dicts],
+  3000 = length(Vecs) + length(Tuples) + length(Dicts).
+
+t_vector_equality_and_str(_Config) ->
+  V1 = make_vector([1, {string, "x"}, [a, b]]),
+  V2 = make_vector([1.0, {string, "x"}, [a, b]]),
+  V3 = make_vector([1, {string, "y"}, [a, b]]),
+  true = shen_erl_kl_primitives:'='(V1, V1),
+  true = shen_erl_kl_primitives:'='(V1, V2),
+  false = shen_erl_kl_primitives:'='(V1, V3),
+  false = shen_erl_kl_primitives:'='(V1, make_vector([1, {string, "x"}])),
+  %% Unset slots compare equal to unset slots only.
+  true = shen_erl_kl_primitives:'='(shen_erl_kl_primitives:absvector(2),
+                                    shen_erl_kl_primitives:absvector(2)),
+  false = shen_erl_kl_primitives:'='(shen_erl_kl_primitives:absvector(1),
+                                     make_vector([0])),
+  true = shen_erl_kl_primitives:'='(shen_erl_kl_overrides:'@p'(1, 2),
+                                    shen_erl_kl_overrides:'@p'(1, 2)),
+  {string, "VECTOR: #Ref<" ++ Rest} = shen_erl_kl_primitives:str(V1),
+  "]3[" ++ _ = lists:reverse(Rest),
+  {string, "DICTIONARY: #Ref<" ++ _} =
+    shen_erl_kl_primitives:str(shen_erl_kl_overrides:'shen.dict'(8)),
+  %% Boxed values still pass through interop untouched.
+  V1 = shen_erl_interop:to_shen(V1),
+  D = shen_erl_kl_overrides:'shen.dict'(8),
+  D = shen_erl_interop:to_shen(D).
+
+%% Any process can allocate (allocation no longer bumps the shared counter
+%% table, which only its owner may write).  Tables stay protected: the
+%% allocating process writes, other processes read.
+t_vector_tables_across_processes(_Config) ->
+  Self = self(),
+  Pid = spawn_link(fun() ->
+                       V = make_vector([a, b]),
+                       Self ! {vector, V},
+                       receive done -> ok end
+                   end),
+  V = receive {vector, Vec} -> Vec after 5000 -> ct:fail(no_vector) end,
+  a = shen_erl_kl_primitives:'<-address'(V, 0),
+  b = shen_erl_kl_primitives:'<-address'(V, 1),
+  {'EXIT', {badarg, _}} = (catch shen_erl_kl_primitives:'address->'(V, 0, z)),
+  {vector, 2, Tab} = V,
+  Pid = ets:info(Tab, owner),
+  protected = ets:info(Tab, protection),
+  Pid ! done,
+  ok.
+
+make_vector(Elems) ->
+  V = shen_erl_kl_primitives:absvector(length(Elems)),
+  lists:foldl(fun({I, E}, Acc) -> shen_erl_kl_primitives:'address->'(Acc, I, E) end,
+              V, lists:zip(lists:seq(0, length(Elems) - 1), Elems)).
