diff --git a/src/shen_erl_global_stores.erl b/src/shen_erl_global_stores.erl
index 7fd36d8..059cad1 100644
--- a/src/shen_erl_global_stores.erl
+++ b/src/shen_erl_global_stores.erl
@@ -38,7 +38,7 @@
                        shen_erl_kl_json]).
 -define(PORT_KL_NON_OVERRIDABLE_MODS, [shen_erl_kl_overrides]).
 
--opaque dict() :: atom().
+-opaque dict() :: ets:tid().
 
 %%%===================================================================
 %%% API
@@ -90,12 +90,13 @@ get_varname() ->
   ets:insert(?VARIABLE_COUNTER_STORE_NAME, {?VARIABLE_COUNTER_KEY, Counter + 1}),
   Counter.
 
+%% Backing store for absvectors and dictionaries: an unnamed table, so
+%% allocation creates no atom and does not touch the shared counter table.
+%% Protected, as before: the allocating process writes, any process reads.
+%% The table lives until its owner exits; nothing deletes it earlier.
 -spec dict_new() -> dict().
 dict_new() ->
-  NewCounter = get_varname(),
-  DictName = list_to_atom("DICT" ++ integer_to_list(NewCounter)),
-  ets:new(DictName, [set, named_table]),
-  DictName.
+  ets:new(dict, [set, protected]).
 
 -spec dict_count(dict()) -> non_neg_integer().
 dict_count(Dict) ->
diff --git a/src/shen_erl_interop.erl b/src/shen_erl_interop.erl
index c0852ad..a02037c 100644
--- a/src/shen_erl_interop.erl
+++ b/src/shen_erl_interop.erl
@@ -51,9 +51,9 @@ to_shen([H | T]) ->
   [to_shen(H) | to_shen(T)];
 to_shen(Boxed = {string, Chars}) when is_list(Chars) ->
   Boxed;
-to_shen(Boxed = {vector, Len, Tab}) when is_integer(Len), is_atom(Tab) ->
+to_shen(Boxed = {vector, Len, Tab}) when is_integer(Len), is_reference(Tab) ->
   Boxed;
-to_shen(Boxed = {dict, Tab}) when is_atom(Tab) ->
+to_shen(Boxed = {dict, Tab}) when is_reference(Tab) ->
   Boxed;
 to_shen(Tuple) when is_tuple(Tuple) ->
   [to_shen(E) || E <- tuple_to_list(Tuple)];
