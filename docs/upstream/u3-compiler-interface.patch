+%% Whether set_mfa/2 would take effect for FunName: false only for the
+%% non-overridable port functions (shen_erl_kl_overrides).
+-spec is_overridable(atom()) -> boolean().
+is_overridable(FunName) ->
+  case lookup(?FUNCTIONS_STORE_NAME, FunName) of
+    {ok, {_MFA, false}} -> false;
+    _ -> true
+  end.
+
 -spec get_val(atom()) -> {ok, term()} | not_found.
