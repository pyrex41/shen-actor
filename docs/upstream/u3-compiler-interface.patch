+%% to a non-overridable port function.
+local_funs(Mod, ToplevelDefs) ->
+  maps:from_list([{Name, {Mod, Name, length(Args)}} ||
+                   [defun, Name, Args, _Body] <- ToplevelDefs,
+                   is_atom(Name), is_list(Args),
+                   shen_erl_global_stores:is_overridable(Name)]).
