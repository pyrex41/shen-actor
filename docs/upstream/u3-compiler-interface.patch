+-spec forms(module(), [shen_erl_kl_parse:kl_tree()], atom()) -> [erl_parse:abstract_form()].
+forms(Mod, ToplevelDefs, DefaultTle) ->
+  toplevel_forms(Mod, ToplevelDefs, DefaultTle, local_funs(Mod, ToplevelDefs)).
+
+%% Loads a module compiled from KL and registers its exported functions
+%% (other than kl_tle/0) in the function store.  Returns the registered
+%% functions; a name bound to a non-overridable port function is left alone.
+-spec load(module(), binary()) -> {ok, [{atom(), arity()}]} | {error, term()}.
+load(Mod, Bin) ->
+  case code:load_binary(Mod, [], Bin) of
+    {module, Mod} ->
+      Funs = [{Name, Arity} || {Name, Arity} <- Mod:module_info(exports),
+                               Name =/= kl_tle, Name =/= module_info,
+                               shen_erl_global_stores:is_overridable(Name)],
+      [shen_erl_global_stores:set_mfa(Name, {Mod, Name, Arity}) || {Name, Arity} <- Funs],
+      {ok, Funs};
+    {error, Reason} ->
+      {error, Reason}
+  end.
+
+%% Registers the defun before compiling it.  Kept for existing callers; eval/1
+%% no longer uses it.
