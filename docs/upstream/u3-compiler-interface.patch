+-module(shen_erl_compiler_api_SUITE).
+
+-export([suite/0,
+         all/0,
+         init_per_testcase/2,
+         end_per_testcase/2,
+         t_forms_without_loading/1,
+         t_forms_binding/1,
+         t_compile_load_call/1,
+         t_redefine_arity/1,
+         t_arity/1,
+         t_non_overridable/1,
+         t_eval_registers_after_load/1,
+         t_parse_round_trip/1,
+         t_parse_errors/1,
+         t_codegen_error/1,
+         t_shen_booted/1]).
+
+-include_lib("common_test/include/ct.hrl").
+
+-define(FUNS_STORE, '_kl_funs_store').
+
+%%%===================================================================
+%%% Common test
+%%%===================================================================
+
+suite() ->
+  [{timetrap, {minutes, 2}}].
+
+all() ->
+  [t_forms_without_loading,
+   t_forms_binding,
+   t_compile_load_call,
+   t_redefine_arity,
+   t_arity,
+   t_non_overridable,
+   t_eval_registers_after_load,
+   t_parse_round_trip,
+   t_parse_errors,
+   t_codegen_error,
+   t_shen_booted].
+
+%% ETS stores are owned by the test case process, so each case creates its
+%% own.  Only t_shen_booted boots the kernel.
+init_per_testcase(Case, Config) ->
+  shen_erl_global_stores:init(),
+  case Case of
+    t_shen_booted ->
+      shen_erl_kl_primitives:set('*stoutput*', standard_io),
+      shen_erl_kl_primitives:set('*stinput*', standard_io),
+      shen_erl_kl_compiler:boot();
+    _ ->
+      ok
+  end,
+  Config.
+
+end_per_testcase(_Case, _Config) ->
+  [begin code:purge(M), code:delete(M), code:purge(M) end
+   || {M, _} <- code:all_loaded(), lists:prefix("_kl_api", atom_to_list(M))],
+  ok.
+
+%%%===================================================================
+%%% Test cases
+%%%===================================================================
+
+%% forms/2 and compile/2 neither load anything nor change the function store.
+t_forms_without_loading(_Config) ->
+  {ok, Kl} = shen_erl_compiler_api:parse_string(
+               "(defun api-nl-f (X) (+ X 1))"
+               "(defun api-nl-g (X) (api-nl-f (api-nl-f X)))"
+               "(api-nl-g 1)"),
+  %% Warm up: the first compile loads the Erlang compiler's own modules.
+  {ok, _} = shen_erl_compiler_api:compile('_kl_api_warmup', Kl),
+  Store = lists:sort(ets:tab2list(?FUNS_STORE)),
+  Loaded = lists:sort([M || {M, _} <- code:all_loaded()]),
+
+  {ok, Forms} = shen_erl_compiler_api:forms('_kl_api_nl', Kl),
+  {ok, Bin} = shen_erl_compiler_api:compile('_kl_api_nl', Kl),
+
+  Store = lists:sort(ets:tab2list(?FUNS_STORE)),
+  Loaded = lists:sort([M || {M, _} <- code:all_loaded()]),
+  false = code:is_loaded('_kl_api_nl'),
+  not_found = shen_erl_compiler_api:lookup('api-nl-f'),
+
+  %% The abstract forms are what compile/2 compiles.
+  [{attribute, _, module, '_kl_api_nl'} | _] = Forms,
+  {ok, '_kl_api_nl', _, _} = compile:forms(Forms, [return_errors, return_warnings]),
+  {ok, {'_kl_api_nl', [{exports, Exports}]}} = beam_lib:chunks(Bin, [exports]),
+  [{'api-nl-f', 1}, {'api-nl-g', 1}, {kl_tle, 0}] =
+    lists:sort([E || E = {N, _} <- Exports, N =/= module_info]).
+
+%% Calls between a module's own defuns resolve to that module: through
+%% runtime dispatch for a _kl_ module, as static remote calls otherwise.
+t_forms_binding(_Config) ->
+  {ok, Kl} = shen_erl_compiler_api:parse_string(
+               "(defun s-f (X) X) (defun s-g (X) (s-f X))"),
+  {ok, Static} = shen_erl_compiler_api:forms(api_static, Kl),
+  true = contains({remote, any, {atom, any, api_static}, {atom, any, 's-f'}}, Static),
+  false = contains({atom, any, invoke}, Static),
+  {ok, Dynamic} = shen_erl_compiler_api:forms('_kl_api_dyn', Kl),
+  true = contains({remote, any, {atom, any, shen_erl_kl_compiler}, {atom, any, invoke}}, Dynamic),
+  false = contains({atom, any, '_kl_api_dyn'}, tl(Dynamic)),
+  not_found = shen_erl_compiler_api:lookup('s-f').
+
+t_compile_load_call(_Config) ->
+  {ok, Kl} = shen_erl_compiler_api:parse_string(
+               "(defun api-add (X Y) (+ X Y))\n"
+               "(defun api-twice (X) (api-add X X))\n"
+               "(defun api-adder (X) (lambda Y (+ X Y)))\n"
+               "(api-twice 21)\n"),
+  {ok, Bin} = shen_erl_compiler_api:compile('_kl_api_m', Kl),
+  not_found = shen_erl_compiler_api:lookup('api-add'),
+  {ok, Registered} = shen_erl_compiler_api:load('_kl_api_m', Bin),
+  [{'api-add', 2}, {'api-adder', 1}, {'api-twice', 1}] = lists:sort(Registered),
+  {ok, {'_kl_api_m', 'api-add', 2}} = shen_erl_compiler_api:lookup('api-add'),
+  10 = shen_erl_compiler_api:call('api-twice', [5]),
+  42 = shen_erl_compiler_api:run_toplevel('_kl_api_m'),
+  %% Fewer arguments than the arity: curried.
+  Inc = shen_erl_compiler_api:call('api-add', [1]),
+  3 = Inc(2),
+  Curried = shen_erl_compiler_api:call('api-add', []),
+  7 = (Curried(3))(4),
+  %% More arguments than the arity: the result is applied to the rest.
+  3 = shen_erl_compiler_api:call('api-adder', [1, 2]),
+  {'EXIT', {{undef, 'api-missing'}, _}} =
+    catch shen_erl_compiler_api:call('api-missing', [1]),
+  %% A module without toplevel expressions returns ok.
+  {ok, Bin2} = shen_erl_compiler_api:compile('_kl_api_m2', [[defun, 'api-id', ['X'], 'X']]),
+  {ok, [{'api-id', 1}]} = shen_erl_compiler_api:load('_kl_api_m2', Bin2),
+  ok = shen_erl_compiler_api:run_toplevel('_kl_api_m2').
+
+%% Redefining a function with another arity: callers compiled earlier see the
+%% new binding through runtime dispatch.
+t_redefine_arity(_Config) ->
+  load_kl('_kl_api_f1', "(defun api-f (X) (* X 10))"),
+  load_kl('_kl_api_user', "(defun api-use (X) (api-f X))"),
+  10 = shen_erl_compiler_api:call('api-use', [1]),
+  {ok, 1} = shen_erl_compiler_api:arity('api-f'),
+
+  load_kl('_kl_api_f2', "(defun api-f (X Y) (+ X Y))"),
+  {ok, 2} = shen_erl_compiler_api:arity('api-f'),
+  {ok, {'_kl_api_f2', 'api-f', 2}} = shen_erl_compiler_api:lookup('api-f'),
+  5 = shen_erl_compiler_api:call('api-f', [2, 3]),
+  Partial = shen_erl_compiler_api:call('api-use', [1]),
+  true = is_function(Partial, 1),
+  3 = Partial(2),
+
+  %% Reloading the same module name replaces its code.
+  load_kl('_kl_api_f2', "(defun api-f () 99)"),
+  {ok, 0} = shen_erl_compiler_api:arity('api-f'),
+  99 = shen_erl_compiler_api:call('api-f', []).
+
+t_arity(_Config) ->
+  {ok, 2} = shen_erl_compiler_api:arity('+'),
+  {ok, 1} = shen_erl_compiler_api:arity(hd),
+  not_found = shen_erl_compiler_api:arity('api-nothing'),
+  not_found = shen_erl_compiler_api:lookup('api-nothing'),
+  load_kl('_kl_api_ar', "(defun api-three (A B C) (cons A (cons B (cons C ()))))"),
+  {ok, 3} = shen_erl_compiler_api:arity('api-three'),
+  [a, b, c] = shen_erl_compiler_api:call('api-three', [a, b, c]).
+
+%% Names bound to the port's non-overridable functions keep their binding.
+t_non_overridable(_Config) ->
+  {ok, Before} = shen_erl_compiler_api:lookup('not'),
+  {ok, Bin} = shen_erl_compiler_api:compile('_kl_api_no',
+                                            [[defun, 'not', ['X'], 'X'],
+                                             [defun, 'api-neg', ['X'], ['not', 'X']]]),
+  {ok, [{'api-neg', 1}]} = shen_erl_compiler_api:load('_kl_api_no', Bin),
+  {ok, Before} = shen_erl_compiler_api:lookup('not'),
+  false = shen_erl_compiler_api:call('api-neg', [true]).
+
+%% eval/1 compiles without registering, then registers after loading; the
+%% result is as before (defun returns its name, and is bound to _kl_<Name>).
+t_eval_registers_after_load(_Config) ->
+  {ok, [Fact]} = shen_erl_compiler_api:parse_string(
+                   "(defun api-fact (N) (if (= N 0) 1 (* N (api-fact (- N 1)))))"),
+  'api-fact' = shen_erl_kl_codegen:eval(Fact),
+  {ok, {'_kl_api-fact', 'api-fact', 1}} = shen_erl_compiler_api:lookup('api-fact'),
+  120 = shen_erl_compiler_api:call('api-fact', [5]),
+  {ok, [Exp]} = shen_erl_compiler_api:parse_string("(api-fact 4)"),
+  24 = shen_erl_kl_codegen:eval(Exp),
+  %% Redefinition with a different arity through eval/1.
+  {ok, [Fact2]} = shen_erl_compiler_api:parse_string("(defun api-fact (A B) (* A B))"),
+  'api-fact' = shen_erl_kl_codegen:eval(Fact2),
+  {ok, 2} = shen_erl_compiler_api:arity('api-fact'),
+  6 = shen_erl_kl_codegen:eval([['api-fact', 2], 3]),
+  code:purge('_kl_api-fact'), code:delete('_kl_api-fact'), code:purge('_kl_api-fact').
+
+%% Parsing and printing KL is a round trip, from text and from a file.
+t_parse_round_trip(Config) ->
+  Source = "(defun api-rt (X) (cons \"s\" (cons -1.5 (cons X ()))))\n"
+           "(api-rt 7)\n"
+           "(let L (lambda Y Y) (L sym))\n",
+  {ok, Kl} = shen_erl_compiler_api:parse_string(Source),
+  [[defun, 'api-rt', ['X'], [cons, {string, "s"}, [cons, -1.5, [cons, 'X', []]]]],
+   ['api-rt', 7],
+   ['let', 'L', [lambda, 'Y', 'Y'], ['L', sym]]] = Kl,
+  {ok, Kl} = shen_erl_compiler_api:parse_string(print_kl(Kl)),
+  {ok, Kl} = shen_erl_compiler_api:parse_string(list_to_binary(Source)),
+  File = filename:join(?config(priv_dir, Config), "api_rt.kl"),
+  ok = file:write_file(File, print_kl(Kl)),
+  {ok, Kl} = shen_erl_compiler_api:parse_file(File),
+  {ok, []} = shen_erl_compiler_api:parse_string(""),
+  %% Text is code points; files are bytes, as the kernel reads them.
+  {ok, [{string, [16#E9]}]} = shen_erl_compiler_api:parse_string(<<"\"", 16#C3, 16#A9, "\"">>),
+  ok = file:write_file(File, <<"\"", 16#C3, 16#A9, "\"">>),
+  {ok, [{string, [16#C3, 16#A9]}]} = shen_erl_compiler_api:parse_file(File),
+  %% The parsed forms compile and run.
+  {ok, Bin} = shen_erl_compiler_api:compile('_kl_api_rt', Kl),
+  {ok, _} = shen_erl_compiler_api:load('_kl_api_rt', Bin),
+  sym = shen_erl_compiler_api:run_toplevel('_kl_api_rt'),
+  [{string, "s"}, -1.5, 7] = shen_erl_compiler_api:call('api-rt', [7]).
+
+t_parse_errors(_Config) ->
+  {error, _} = shen_erl_compiler_api:parse_string("(defun f (X) X"),
+  {error, _} = shen_erl_compiler_api:parse_string(")"),
+  {error, enoent} = shen_erl_compiler_api:parse_file("/nonexistent/shen-erl.kl").
+
+t_codegen_error(_Config) ->
+  {error, {codegen, _}} = shen_erl_compiler_api:forms('_kl_api_bad', [['%%goto-label', nolabel]]),
+  {error, {codegen, _}} = shen_erl_compiler_api:compile('_kl_api_bad', [['%%goto-label', nolabel]]).
+
+%% Against a booted kernel: kernel functions are callable by name, and
+%% update-lambda-table makes an API-loaded function known to Shen's arity.
+t_shen_booted(_Config) ->
+  {ok, _} = shen_erl_compiler_api:arity('shen.initialise'),
+  [3, 2, 1] = shen_erl_compiler_api:call(reverse, [[1, 2, 3]]),
+  load_kl('_kl_api_sh', "(defun api-sh (X Y) (* X Y))"),
+  'api-sh' = shen_erl_compiler_api:call('update-lambda-table', ['api-sh', 2]),
+  2 = shen_erl_kl_compiler:eval("(arity api-sh)"),
+  12 = shen_erl_kl_compiler:eval("((fn api-sh) 3 4)"),
+  [2, 4] = shen_erl_kl_compiler:eval("(map (api-sh 2) [1 2])").
+
+%%%===================================================================
+%%% Helpers
+%%%===================================================================
+
+load_kl(Mod, Source) ->
+  {ok, Kl} = shen_erl_compiler_api:parse_string(Source),
+  {ok, Bin} = shen_erl_compiler_api:compile(Mod, Kl),
+  {ok, Registered} = shen_erl_compiler_api:load(Mod, Bin),
+  Registered.
+
+print_kl(Forms) when is_list(Forms) ->
+  lists:join("\n", [print_exp(F) || F <- Forms]).
+
+print_exp([]) -> "()";
+print_exp(L) when is_list(L) -> ["(", lists:join(" ", [print_exp(E) || E <- L]), ")"];
+print_exp({string, S}) -> [$", S, $"];
+print_exp(A) when is_atom(A) -> atom_to_list(A);
+print_exp(N) when is_integer(N) -> integer_to_list(N);
+print_exp(F) when is_float(F) -> float_to_list(F, [short]).
+
+%% Whether Pattern occurs in Term; the atom any matches anything.
+contains(Pattern, Term) ->
+  match(Pattern, Term) orelse
+    case Term of
+      _ when is_tuple(Term) -> lists:any(fun (T) -> contains(Pattern, T) end, tuple_to_list(Term));
+      _ when is_list(Term) -> lists:any(fun (T) -> contains(Pattern, T) end, Term);
+      _ -> false
+    end.
+
+match(any, _) -> true;
+match(P, T) when is_tuple(P), is_tuple(T), tuple_size(P) =:= tuple_size(T) ->
+  lists:all(fun ({A, B}) -> match(A, B) end,
+            lists:zip(tuple_to_list(P), tuple_to_list(T)));
+match(P, P) -> true;
+match(_, _) -> false.
