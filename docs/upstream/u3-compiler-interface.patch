new file mode 100644
index 0000000..bf3382a
--- /dev/null
+++ b/src/shen_erl_compiler_api.erl
@@ -0,0 +1,173 @@
+%%%-------------------------------------------------------------------
+%%% @doc Public interface to the KLambda compiler and runtime dispatch.
+%%%
+%%% For embedders: tools that read KLambda, generate code from it, or call
+%%% Shen functions from Erlang.  The other shen_erl_* modules are internal and
+%%% may change; this module's functions and specs are the stable contract.
+%%%
+%%% Compiling is split into steps with no side effects on the function store,
+%%% and one explicit step that has them:
+%%%
+%%% <pre>
+%%%   parse_string/1, parse_file/1   KLambda source -> KL forms
+%%%   forms/2                        KL forms -> Erlang abstract forms
+%%%   compile/2                      KL forms -> BEAM binary
+%%%   load/2                         load the binary, register its defuns
+%%%   run_toplevel/1                 run the non-defun forms (kl_tle/0)
+%%% </pre>
+%%%
+%%% A module compiled from KL exports one function per defun, with the defun's
+%%% name and arity, plus kl_tle/0.  kl_tle/0 evaluates the non-defun toplevel
+%%% forms in order and returns the last value, or `ok' when there are none.
+%%% If a name is defined more than once, the last definition is kept.
+%%%
+%%% Calls between the defuns of one module resolve to that module, exactly as
+%%% they will once load/2 registers them; calls to other functions resolve
+%%% through the function store at compile time.  A call to a function that
+%%% lives in a module whose name starts with `_kl_' (the modules
+%%% shen_erl_kl_codegen:eval/1 creates for evaluated defuns), or to a name
+%%% not yet defined, is dispatched at run time through call/2, so it follows
+%%% later redefinitions.  Calls to any other module are static remote calls:
+%%% name a module `_kl_...' to get late binding throughout.
+%%%
+%%% All functions need the stores created by shen_erl_global_stores:init/0
+%%% (their ETS tables belong to the process that called it).  forms/2 and
+%%% compile/2 read the function store and advance the generated-variable
+%%% counter, but do not change any function binding.  None of this updates
+%%% the kernel's own tables (the arity and lambda-form properties in
+%%% *property-vector*), so Shen's (arity F) and (fn F) do not see functions
+%%% registered only through load/2; with a booted kernel, call
+%%% `call('update-lambda-table', [Name, Arity])' for that.
+%%% @end
+%%%-------------------------------------------------------------------
+-module(shen_erl_compiler_api).
+
+%% Source
+-export([parse_string/1,
+         parse_file/1]).
+
+%% Compile and load
+-export([forms/2,
+         compile/2,
+         load/2,
+         run_toplevel/1]).
+
+%% Dispatch
+-export([call/2,
+         arity/1,
+         lookup/1]).
+
+-export_type([kl_form/0]).
+
+%% A KL toplevel form as produced by the parser: symbols are atoms, strings
+%% are {string, Chars}, lists are Erlang lists.
+-type kl_form() :: shen_erl_kl_parse:kl_tree().
+
+%%%===================================================================
+%%% Source
+%%%===================================================================
+
+%% @doc Parses KLambda source text into its toplevel forms.  A binary is
+%% decoded as UTF-8; string literals keep Unicode code points.
+-spec parse_string(unicode:chardata()) -> {ok, [kl_form()]} | {error, term()}.
+parse_string(Source) ->
+  case unicode:characters_to_list(Source) of
+    Chars when is_list(Chars) -> parse_chars(Chars);
+    _Invalid -> {error, invalid_unicode}
+  end.
+
+%% @doc Parses a KLambda source file into its toplevel forms.  The file is
+%% read as bytes, as the kernel build reads its .kl files, so non-ASCII
+%% characters in string literals appear as their UTF-8 bytes.
+-spec parse_file(file:filename()) -> {ok, [kl_form()]} | {error, term()}.
+parse_file(Filename) ->
+  case file:read_file(Filename) of
+    {ok, Bytes} -> parse_chars(binary_to_list(Bytes));
+    {error, Reason} -> {error, Reason}
+  end.
+
+%%%===================================================================
+%%% Compile and load
+%%%===================================================================
+
+%% @doc Compiles KL toplevel forms for module Mod into Erlang abstract
+%% forms (ready for compile:forms/2).  Nothing is loaded or registered.
+%% Returns `{error, {codegen, Reason}}' for KL the code generator does not
+%% accept.
+-spec forms(module(), [kl_form()]) ->
+        {ok, [erl_parse:abstract_form()]} | {error, {codegen, term()}}.
+forms(Mod, KlForms) when is_atom(Mod), is_list(KlForms) ->
+  try
+    {ok, shen_erl_kl_codegen:forms(Mod, KlForms, ok)}
+  catch
+    error:Reason -> {error, {codegen, Reason}}
+  end.
+
+%% @doc Compiles KL toplevel forms for module Mod into a BEAM binary.
+%% Nothing is loaded or registered.  Erlang compiler errors come back as
+%% `{error, {compile, Errors, Warnings}}' in the format of compile:forms/2.
+-spec compile(module(), [kl_form()]) ->
+        {ok, binary()} | {error, {codegen, term()} | {compile, list(), list()}}.
+compile(Mod, KlForms) ->
+  case forms(Mod, KlForms) of
+    {ok, Forms} ->
+      case compile:forms(Forms, [return_errors, return_warnings]) of
+        {ok, Mod, Bin, _Warnings} -> {ok, Bin};
+        {error, Errors, Warnings} -> {error, {compile, Errors, Warnings}}
+      end;
+    {error, Reason} ->
+      {error, Reason}
+  end.
+
+%% @doc Loads a binary produced by compile/2 and registers each of its
+%% defuns in the function store as {Mod, Name, Arity}, replacing earlier
+%% bindings (including other arities).  Names bound to the port's
+%% non-overridable functions keep their binding and are left out of the
+%% result.  Loading a module that is already loaded replaces its code.  Does
+%% not run the module's toplevel forms; see run_toplevel/1.
+-spec load(module(), binary()) -> {ok, [{atom(), arity()}]} | {error, term()}.
+load(Mod, Bin) when is_atom(Mod), is_binary(Bin) ->
+  shen_erl_kl_codegen:load(Mod, Bin).
+
+%% @doc Runs the non-defun toplevel forms of a loaded module and returns the
+%% last one's value (`ok' if there are none).
+-spec run_toplevel(module()) -> term().
+run_toplevel(Mod) ->
+  Mod:kl_tle().
+
+%%%===================================================================
+%%% Dispatch
+%%%===================================================================
+
+%% @doc Calls a Shen function by name through its current binding, with the
+%% semantics of a KL application: with fewer arguments than its arity the
+%% result is a curried closure taking one argument at a time; with more, the
+%% result is applied to the rest one at a time.  Raises error:{undef, Name}
+%% for an unbound name.
+-spec call(atom(), [term()]) -> term().
+call(Name, Args) when is_atom(Name), is_list(Args) ->
+  shen_erl_kl_compiler:invoke(Name, Args).
+
+%% @doc The arity call/2 uses for Name: that of its current binding.
+-spec arity(atom()) -> {ok, arity()} | not_found.
+arity(Name) ->
+  case lookup(Name) of
+    {ok, {_Mod, _Fun, Arity}} -> {ok, Arity};
+    not_found -> not_found
+  end.
+
+%% @doc The Erlang function currently bound to Name.
+-spec lookup(atom()) -> {ok, mfa()} | not_found.
+lookup(Name) when is_atom(Name) ->
+  shen_erl_global_stores:get_mfa(Name).
+
+%%%===================================================================
+%%% Internal functions
+%%%===================================================================
+
+parse_chars(Chars) ->
+  case shen_erl_kl_scan:string(Chars) of
+    {ok, [], _EndLine} -> {ok, []};
+    {ok, Tokens, _EndLine} -> shen_erl_kl_parse:parse_tree(Tokens);
+    {error, ErrorInfo, _ErrorLine} -> {error, ErrorInfo}
+  end.
