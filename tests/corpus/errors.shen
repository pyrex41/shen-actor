\\ Error construction, trapping and propagation.
(output "~A~%" (trap-error (error "boom ~A" 1) (/. E (error-to-string E))))
(output "~A~%" (trap-error (simple-error "plain") (/. E (error-to-string E))))
(output "~A~%" (trap-error ok (/. E caught)))
(define fails X -> (error "fails on ~S" X))
(define via F X -> [wrapped (F X)])
(output "~A~%" (trap-error (via (fn fails) abc) (/. E (error-to-string E))))
(output "~A~%" (trap-error (trap-error (error "inner") (/. E (error "outer"))) (/. E (error-to-string E))))
(output "~A~%" (trap-error (hd []) (/. E caught-hd)))
(output "~A~%" (trap-error (/ 1 0) (/. E caught-div)))
(output "~A~%" (trap-error (value no-such-global-xyz) (/. E caught-value)))
(set side 0)
(trap-error (do (set side 1) (error "stop") (set side 2)) (/. E skip))
(output "side: ~A~%" (value side))
