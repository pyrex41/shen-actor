\\ Closures capture values, not variables.
(define adder N -> (/. X (+ X N)))
(set a5 (adder 5))
(output "~A~%" ((value a5) 1))
(define counter -> (let Box (@v 0 <>) (/. Ignored (do (vector-> Box 1 (+ 1 (<-vector Box 1))) (<-vector Box 1)))))
(set c (counter))
((value c) go)
((value c) go)
(output "~A~%" ((value c) go))
(set d (counter))
(output "~A~%" ((value d) go))
(define make-list N -> (map (/. I (/. Ignored I)) [1 2 3]))
(output "~A~%" (map (/. F (F ignored)) (make-list ignored)))
(let X 1 F (/. Y (+ X Y)) X 100 (output "~A~%" (F 1)))
(output "~A~%" (let F (freeze (adder 2)) ((thaw F) 40)))
