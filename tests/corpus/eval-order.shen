\\ Sequencing: do, let and argument evaluation order.
(set trace [])
(define note X -> (do (set trace [X | (value trace)]) X))
(do (note a) (note b) (note c))
(output "do: ~S~%" (reverse (value trace)))
(set trace [])
(let X (note x) Y (note y) [X Y])
(output "let: ~S~%" (reverse (value trace)))
(set trace [])
(define three A B C -> [A B C])
(three (note 1) (note 2) (note 3))
\\ Shen does not fix argument order; this records shen-erl's.
(output "args: ~S~%" (reverse (value trace)))
(set trace [])
(if (note true) (note then) (note else))
(output "if: ~S~%" (reverse (value trace)))
(set trace [])
(and (note false) (note never))
(output "and: ~S~%" (reverse (value trace)))
(set trace [])
(or (note true) (note never))
(output "or: ~S~%" (reverse (value trace)))
