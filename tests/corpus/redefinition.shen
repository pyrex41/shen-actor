\\ Redefinition, including a change of arity, is seen by existing callers.
(define g X -> [one X])
(define call-g -> (g 1))
(output "~A~%" (call-g))
(define g X -> [two X])
(output "~A~%" (call-g))
(define h X -> [h1 X])
(set hf (fn h))
(define h X Y -> [h2 X Y])
(output "~A~%" (h 1 2))
(output "~A~%" ((h 1) 2))
(output "~A~%" (arity h))
(define k -> zero)
(output "~A~%" (k))
(define k X -> [k1 X])
(output "~A~%" (k 5))
