\\ Vectors and globals are mutable; aliases see writes.
(set v (vector 3))
(vector-> (value v) 1 a)
(set alias (value v))
(vector-> (value alias) 2 b)
(output "~A ~A~%" (<-vector (value v) 1) (<-vector (value v) 2))
(output "~A~%" (limit (value v)))
(output "~A~%" (trap-error (<-vector (value v) 3) (/. E unset)))
(set g 1)
(define bump -> (set g (+ 1 (value g))))
(bump)
(bump)
(output "~A~%" (value g))
(define fill V N -> V where (> N (limit V))
             V N -> (fill (vector-> V N (* N N)) (+ N 1)))
(output "~A~%" (fill (vector 4) 1))
(put widget colour red)
(put widget colour blue)
(output "~A~%" (get widget colour))
